{
  "presets": [
    [
      "@babel/preset-env",
      {
        "debug": true,
        "modules": "commonjs",
        "targets": "> 0.5%, not dead or node 22"
      }
    ]
  ],
  "plugins": [
    "@babel/plugin-transform-class-properties",
    [
      "babel-plugin-polyfill-corejs3",
      {
        "method": "usage-pure",
        "corejs": "corejs",
        "version": "3.50",
        "targets": "> 0.5%, not dead or node 22"
      }
    ]
  ]
}
