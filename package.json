{
  "name": "star2star-js-ms-sdk",
  "version": "4.17.3",
  "description": "Star2Star JavaScript Micro Service SDK",
  "main": "./lib/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "preclean": "npm install --no-save rimraf",
    "clean": "rimraf lib && mkdir lib && rimraf package-lock.json && rimraf node_modules && npm install",
    "test": "nyc --concurrency=1 --reporter=text mocha --require test/setup.js --timeout 15000 'test/**/*.js' --ignore 'test/**/*.live.js'",
    "test:unit": "nyc --concurrency=1 --reporter=text mocha --require test/setup.js test/index.js test/utilities.js test/workflow.js --timeout 15000",
    "test:integration": "nyc --concurrency=1 --reporter=text mocha --require test/setup.js --timeout 15000 'test/**/*.js' --ignore test/index.js --ignore test/utilities.js --ignore 'test/**/*.live.js'",
    "test:live": "USE_LIVE_MS=1 env-cmd --verbose -e appDev -- nyc --concurrency=1 --reporter=text mocha --require test/setup.js --timeout 120000 'test/**/*.js' --ignore test/index.js --ignore test/utilities.js",
    "test:workflow:live": "USE_LIVE_MS=1 env-cmd --verbose -e appDev -- mocha --require test/setup.js test/workflow.live.js --timeout 120000",
    "build": "npm run clean && npm run doc && babel src -d lib && npm prune --omit-dev",
    "gitTag": "git tag \"$npm_package_name\"_\"$npm_package_version\" && git push origin \"$npm_package_name\"_\"$npm_package_version\"",
    "doc": "documentation build src/index.js -f html -o . --config documentation.yml"
  },
  "keywords": [
    "micro service",
    "sdk",
    "ms",
    "js"
  ],
  "author": "Sangoma Integration Studio Team",
  "license": "MIT",
  "dependencies": {
    "compare-versions": "6.1.1",
    "core-js-pure": "3.50.0",
    "email-validator": "2.0.4",
    "form-data": "4.0.6",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.6",
    "@babel/plugin-transform-class-properties": "8.0.1",
    "@babel/preset-env": "8.0.6",
    "babel-plugin-polyfill-corejs3": "1.0.0",
    "documentation": "14.0.3",
    "env-cmd": "11.0.0",
    "mocha": "12.0.2",
    "nyc": "18.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "allowScripts": {
    "core-js-pure@3.50.0": true,
    "fsevents@2.3.3": true
  },
  "nyc": {
    "concurrency": 1
  }
}
